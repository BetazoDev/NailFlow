# Normalise line endings so the repo is identical on Windows, macOS and Linux.
* text=auto eol=lf

# Binary assets are never converted.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.ico binary
*.woff binary
*.woff2 binary

# The lockfile is generated; collapse it in diffs and reviews.
package-lock.json linguist-generated=true -diff
