# ─── API ─────────────────────────────────────────────────────────────────────
# Base URL of the NailFlow API. No trailing slash, no /api suffix.
NEXT_PUBLIC_API_URL=http://localhost:3001

# ─── Firebase (client SDK) ───────────────────────────────────────────────────
# Public by design — access is governed by Firebase security rules, not secrecy.
# Kept in the environment so staging cannot write to the production project.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── The account domain ──────────────────────────────────────────────────────
# The one host that Firebase has been told about, e.g. "cuenta.example.com".
#
# Google sign-in and the return address of an invitation link both have to land
# on a domain in Firebase's authorised list, and that list takes no wildcards —
# so a salon's own subdomain can never be one of them. This names the single
# host that is, and `/entrar` forwards her from there to her own panel.
#
# Left empty, the Google button is offered on every salon's subdomain, where it
# fails with `auth/unauthorized-domain` and she blames her password. Set it to
# the same value as APP_ACCOUNT_DOMAIN in the API.
NEXT_PUBLIC_ACCOUNT_DOMAIN=

# ─── CDN ─────────────────────────────────────────────────────────────────────
# Nothing here any more. Image uploads go to the API, which holds each
# salon's own key sealed in the database; the web app never sees one.

# ─── Multi-tenant routing ────────────────────────────────────────────────────
# Comma-separated hosts served directly instead of being rewritten to a
# tenant subpath (the marketing site and the admin panel).
PRIMARY_HOSTS=localhost:3000
