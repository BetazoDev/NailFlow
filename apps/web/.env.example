# ─── API ─────────────────────────────────────────────────────────────────────
# Base URL of the NailFlow API. No trailing slash, no /api suffix.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Top-level CDN folder for this deployment's images.
NEXT_PUBLIC_CDN_SLUG=nailssalon

# ─── Firebase (client SDK) ───────────────────────────────────────────────────
# Public by design — access is governed by Firebase security rules, not secrecy.
# Kept in the environment so staging cannot write to the production project.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── CDN (server-side only — never prefixed with NEXT_PUBLIC_) ───────────────
CDN_API_URL=https://api.diabolicalservices.tech
# Key for salon-managed folders (services, team, branding).
CDN_UPLOAD_TOKEN=
# Key for client-uploaded booking reference photos.
CDN_API_KEY_REFERENCES=

# ─── Multi-tenant routing ────────────────────────────────────────────────────
# Comma-separated hosts served directly instead of being rewritten to a
# tenant subpath (the marketing site and the admin panel).
PRIMARY_HOSTS=localhost:3000
