# ─── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development

# Local development only. In production leave this unset so the container
# listens on 3000, which is the port the reverse proxy targets.
PORT=3001

# Public URL of this API. Mercado Pago posts its payment webhook here.
APP_BASE_URL=http://localhost:3001

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/nailflow

# Create/patch tables on boot. Turn off in production once schema is stable.
DB_AUTO_MIGRATE=true

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call this API from a browser.
# Wildcards are NOT accepted: the API reads Authorization headers.
CORS_ORIGINS=http://localhost:3000

# ─── Firebase Admin (token verification) ─────────────────────────────────────
# Either paste the service-account JSON on one line…
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account", ...}
# …or point at the file:
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json

# ─── Mercado Pago ────────────────────────────────────────────────────────────
# Leave unset to run without online payments.
MP_ACCESS_TOKEN=
# From the Mercado Pago webhook settings. Required to accept payment webhooks.
MP_WEBHOOK_SECRET=

# ─── CDN ─────────────────────────────────────────────────────────────────────
CDN_BASE_URL=https://cdn.diabolicalservices.tech
CDN_API_URL=https://api.diabolicalservices.tech
# Key for salon-managed folders (services, team, branding).
CDN_UPLOAD_TOKEN=
# Key for client-uploaded booking reference photos.
CDN_API_KEY_REFERENCES=

# ─── Automation ──────────────────────────────────────────────────────────────
# n8n workflow that sends WhatsApp confirmations. Optional.
N8N_WEBHOOK_URL=

# ─── Business rules ──────────────────────────────────────────────────────────
# Minimum notice before a client may book (spec §4).
BOOKING_MIN_ADVANCE_DAYS=7
BOOKING_SLOT_HOLD_MINUTES=10
BOOKING_SLOT_INTERVAL_MINUTES=30
# Allows POST /api/bookings/test to confirm without payment. Never enable in production.
ALLOW_TEST_BOOKINGS=true

DEFAULT_TIMEZONE=America/Mexico_City
DEFAULT_CURRENCY=MXN
DEFAULT_OPENING_TIME=09:00
DEFAULT_CLOSING_TIME=21:00

# ─── Retention (spec §10) ────────────────────────────────────────────────────
REFERENCE_IMAGE_RETENTION_DAYS=14
CLEANUP_CRON=0 2 * * *

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
