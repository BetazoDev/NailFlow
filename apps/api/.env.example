# ─── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development

# Local development only. In production leave this unset so the container
# listens on 3000, which is the port the reverse proxy targets.
PORT=3001

# Public URL of this API. Mercado Pago posts its payment webhook here.
APP_BASE_URL=http://localhost:3001

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/nailflow

# Create/patch tables on boot. Turn off in production once schema is stable.
DB_AUTO_MIGRATE=true

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call this API from a browser.
# Wildcards are NOT accepted: the API reads Authorization headers.
CORS_ORIGINS=http://localhost:3000

# ─── Firebase Admin (token verification) ─────────────────────────────────────
# Either paste the service-account JSON on one line…
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account", ...}
# …or point at the file:
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json

# ─── Mercado Pago ────────────────────────────────────────────────────────────
# Leave unset to run without online payments.
MP_ACCESS_TOKEN=
# From the Mercado Pago webhook settings. Required to accept payment webhooks.
MP_WEBHOOK_SECRET=

# ─── CDN ─────────────────────────────────────────────────────────────────────
# Each salon has her own CDN folder and her own keys, set per salon from the
# platform panel and sealed in the database. The values here are the fallback
# for salons that have none yet, and the only way their existing images — all
# of which are still in the one shared folder — keep loading.
#
# Storing per-salon keys needs CREDENTIALS_KEY above; without it the panel says
# so and every salon stays on the shared folder.
CDN_BASE_URL=https://cdn.diabolicalservices.tech
CDN_API_URL=https://api.diabolicalservices.tech
# The folder those shared keys write into.
CDN_SLUG=nailssalon
# Shared key for salon-managed folders (services, team, branding).
CDN_UPLOAD_TOKEN=
# Shared key for client-uploaded booking reference photos.
CDN_API_KEY_REFERENCES=

# ─── Correo saliente (BillionMail) ───────────────────────────────────────────
# Solo se envía una cosa desde aquí: la carta que deja entrar a una dueña en su
# panel por primera vez. Lo que recibe una *clienta* —confirmaciones,
# recordatorios— sigue saliendo por la automatización, porque eso puede llegar
# tarde sin que nadie se quede fuera de nada.
#
# Sin configurar, el panel lo dice y sigue enseñando el enlace para mandarlo a
# mano, que es como funcionaba antes.
#
# El puerto decide el cifrado: 465 va cifrado desde el primer byte, 587 abre en
# claro y sube a TLS. Ponerlo al revés es la razón habitual de que un buzón que
# funciona se niegue a enviar.
SMTP_HOST=mail.diabolicalservices.tech
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# El remitente visible. Tiene que ser un buzón que este servidor pueda usar.
MAIL_FROM="NailFlow <no-reply@diabolicalservices.tech>"
# Adónde va su respuesta si contesta al correo. Opcional.
MAIL_REPLY_TO=

# ─── Automation ──────────────────────────────────────────────────────────────
# n8n workflow that sends WhatsApp confirmations and provisions a new salon's
# image storage. Optional — without it nothing is triggered and every salon
# falls back to the shared CDN folder, which the panel says on her card.
N8N_WEBHOOK_URL=

# Shared secret n8n uses to hand back the CDN folder and keys it created, at
# POST /api/platform/cdn/provisioned with header `x-provision-key`.
#
# Deliberately not a platform-admin login: this token can write one salon's CDN
# account and nothing else — it cannot list salons, delete one, or read a
# payment account. Unset means the route does not exist rather than standing
# open. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
N8N_PROVISION_TOKEN=

# ─── Business rules ──────────────────────────────────────────────────────────
# Minimum notice before a client may book (spec §4).
BOOKING_MIN_ADVANCE_DAYS=7
BOOKING_SLOT_HOLD_MINUTES=10
BOOKING_SLOT_INTERVAL_MINUTES=30
# Allows POST /api/bookings/test to confirm without payment. Never enable in production.
ALLOW_TEST_BOOKINGS=true

DEFAULT_TIMEZONE=America/Mexico_City
DEFAULT_CURRENCY=MXN
DEFAULT_OPENING_TIME=09:00
DEFAULT_CLOSING_TIME=21:00

# ─── Retention (spec §10) ────────────────────────────────────────────────────
REFERENCE_IMAGE_RETENTION_DAYS=14
CLEANUP_CRON=0 2 * * *

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
