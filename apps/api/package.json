{
    "name": "@nailflow/api",
    "version": "0.1.0",
    "private": true,
    "main": "dist/index.js",
    "scripts": {
        "dev": "nodemon --watch src --ext ts --exec ts-node src/index.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/index.js",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "smoke": "node scripts/smoke.mjs"
    },
    "dependencies": {
        "@nailflow/shared": "*",
        "cors": "^2.8.5",
        "dotenv": "^17.3.1",
        "express": "^4.21.1",
        "express-rate-limit": "^7.5.0",
        "firebase-admin": "^13.7.0",
        "helmet": "^8.1.0",
        "luxon": "^3.7.2",
        "mercadopago": "^2.12.0",
        "node-cron": "^4.2.1",
        "pg": "^8.20.0",
        "stripe": "^22.6.1",
        "zod": "^3.24.1"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/luxon": "^3.7.1",
        "@types/node": "^22.8.1",
        "@types/node-cron": "^3.0.11",
        "@types/pg": "^8.18.0",
        "nodemon": "^3.1.7",
        "ts-node": "^10.9.2",
        "typescript": "^5.6.3"
    }
}
